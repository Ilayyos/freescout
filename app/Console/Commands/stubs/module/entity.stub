    /**
     * Scope a query to order by name.
     *
     * @param \Illuminate\Database\Eloquent\Builder $builder
     * @return \Illuminate\Database\Eloquent\Builder
     */
    public function scopeOrdered(Builder $builder): Builder
    {
        return $builder->orderBy('created_at', 'desc');
    }

    /**
     * Scope a query to filter by search term.
     *
     * @param \Illuminate\Database\Eloquent\Builder $builder
     * @param string|null $term
     * @return \Illuminate\Database\Eloquent\Builder
     */
    public function scopeSearch(Builder $builder, ?string $term): Builder
    {
        if (empty($term)) {
            return $builder;
        }

        return $builder->where(function ($query) use ($term) {
            $query->where('id', $term);
            // Add more searchable fields here
        });
    }
